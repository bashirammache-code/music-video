# From Meta developer dashboard > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=            # permanent system-user access token
WHATSAPP_PHONE_NUMBER_ID=  # phone number ID (not the phone number itself)
WHATSAPP_APP_SECRET=       # App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=     # any string you choose; paste the same one in the webhook setup

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: your own WhatsApp number (digits only, e.g. 15551234567) to be alerted on handoff
OWNER_NUMBER=
PORT=3000
