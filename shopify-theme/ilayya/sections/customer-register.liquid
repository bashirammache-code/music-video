<div class="account section-padding">
  <div class="container container--narrow">
    <div class="account-box">
      <h1 class="page__title">Create Account</h1>
      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div class="errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field-row">
          <div class="field">
            <label for="FirstName">First name</label>
            <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
          </div>
          <div class="field">
            <label for="LastName">Last name</label>
            <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
          </div>
        </div>
        <div class="field">
          <label for="RegisterEmail">Email</label>
          <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>
        <div class="field">
          <label for="RegisterPassword">Password</label>
          <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">Create Account</button>
      {%- endform -%}
      <p class="account-box__aside">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Customer register", "settings": [] }
{% endschema %}
