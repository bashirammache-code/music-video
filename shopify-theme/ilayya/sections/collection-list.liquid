<div class="section-padding">
  <div class="container">
    <div class="section-heading section-heading--center">
      <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
    </div>
  </div>
  {%- comment -%}
    The grid itself breaks out of .container to run edge-to-edge (full
    viewport width), with only a hairline gap between tiles — matching a
    reference of Prada's category row rather than the boxed/gapped grid
    this theme used before.
  {%- endcomment -%}
  <div class="category-grid-bleed">
    <div class="category-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.collection.url | default: '#' }}" class="category-tile" {{ block.shopify_attributes }}>
          <div class="category-tile__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.label }}" loading="lazy" width="800" height="{{ 800 | divided_by: block.settings.image.aspect_ratio }}">
            {%- elsif forloop.index == 1 -%}
              {%- comment -%} Falls back to a real product shot until a dedicated Earrings category image is uploaded to this block. {%- endcomment -%}
              <img src="{{ 'category-earrings-knot.png' | asset_url }}" alt="">
            {%- elsif forloop.index == 2 -%}
              {%- comment -%} Falls back to a real product shot until a dedicated Bracelets category image is uploaded to this block. {%- endcomment -%}
              <img src="{{ 'category-bracelet-pearl.png' | asset_url }}" alt="">
            {%- elsif forloop.index == 3 -%}
              {%- comment -%} Falls back to a real product shot until a dedicated Necklaces category image is uploaded to this block. {%- endcomment -%}
              <img src="{{ 'category-necklace-heart.png' | asset_url }}" alt="">
            {%- else -%}
              <div class="category-tile__placeholder"></div>
            {%- endif -%}
          </div>
          <span class="category-tile__label">{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Rings" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "label": "Earrings" } },
      { "type": "category", "settings": { "label": "Bracelets" } },
      { "type": "category", "settings": { "label": "Necklaces" } }
    ]
  }
}
{% endschema %}
