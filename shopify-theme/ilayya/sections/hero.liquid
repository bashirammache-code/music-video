<div class="hero" style="--hero-height: {{ section.settings.height }}px;">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.image.alt | escape }}"
      class="hero__image"
      loading="eager"
      width="2000"
      height="{{ 2000 | divided_by: section.settings.image.aspect_ratio }}">
  {%- else -%}
    <div class="hero__image hero__image--placeholder"></div>
  {%- endif -%}

  <div class="hero__content hero__content--{{ section.settings.alignment }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_url }}" class="btn btn--primary btn--light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "height", "label": "Height (px)", "min": 400, "max": 900, "step": 20, "default": 680 },
    { "type": "select", "id": "alignment", "label": "Content alignment", "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The New Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quietly bold, made to last" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Fine jewelry designed for everyday wear, cast in solid gold and finished by hand." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop New Arrivals" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
