{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="product section-padding">
  <div class="container product__grid">

    <div class="product__gallery">
      {%- if product.media.size > 0 -%}
        <div class="product__gallery-main">
          {%- for media in product.media -%}
            <img
              src="{{ media | image_url: width: 1200 }}"
              alt="{{ media.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="1200"
              height="{{ 1200 | divided_by: media.aspect_ratio }}"
              class="product__gallery-image{% if forloop.first %} is-active{% endif %}"
              data-media-id="{{ media.id }}">
          {%- endfor -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product__gallery-thumbs">
            {%- for media in product.media -%}
              <button class="product__thumb{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ media | image_url: width: 200 }}" alt="" loading="lazy" width="100">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="product__gallery-main">
          <div class="product__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if product.vendor != blank -%}<p class="product__vendor">{{ product.vendor }}</p>{%- endif -%}
      <h1 class="product__title">{{ product.title }}</h1>
      <div id="ProductPrice">{%- render 'price', variant: current_variant -%}</div>

      {%- if product.metafields.reviews.rating -%}
        <div class="product__rating">
          {%- for i in (1..5) -%}{%- render 'icon' with 'star' -%}{%- endfor -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: 'ProductForm', class: 'product__form' -%}
        <input type="hidden" name="id" id="ProductVariantId" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product__option" data-option-position="{{ option.position }}">
              <label class="product__option-label">{{ option.name }}</label>
              <div class="product__option-values">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="option-pill{% if value == option.selected_value %} is-selected{% endif %}"
                    data-option-position="{{ option.position }}"
                    data-option-value="{{ value | escape }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="product__quantity">
          <label for="Quantity">Quantity</label>
          <div class="qty-stepper">
            <button type="button" class="qty-btn" data-qty="decrease" aria-label="Decrease quantity">{%- render 'icon' with 'minus' -%}</button>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" class="qty-btn" data-qty="increase" aria-label="Increase quantity">{%- render 'icon' with 'plus' -%}</button>
          </div>
        </div>

        <button type="submit" class="btn btn--primary btn--full" id="AddToCart" {% unless current_variant.available %}disabled{% endunless %}>
          <span id="AddToCartText">
            {%- if current_variant.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
          </span>
        </button>
      {%- endform -%}

      <div class="product__accordion">
        {%- if product.description != blank -%}
          <details open>
            <summary>Description</summary>
            <div class="product__accordion-content">{{ product.description }}</div>
          </details>
        {%- endif -%}
        <details>
          <summary>Materials &amp; Care</summary>
          <div class="product__accordion-content">
            <p>{{ section.settings.materials_text }}</p>
          </div>
        </details>
        <details>
          <summary>Shipping &amp; Returns</summary>
          <div class="product__accordion-content">
            <p>{{ section.settings.shipping_text }}</p>
          </div>
        </details>
      </div>
    </div>
  </div>

  <script type="application/json" id="ProductVariants-{{ section.id }}">
    {{ product.variants | json }}
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (window.Ilayya && window.Ilayya.initProductForm) {
        window.Ilayya.initProductForm('{{ section.id }}');
      }
    });
  </script>
</div>

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "textarea", "id": "materials_text", "label": "Materials & care text", "default": "14k solid gold. Avoid contact with perfume, lotion, and water. Store in the pouch provided." },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping & returns text", "default": "Free shipping on orders over $150. Free 30-day returns on unworn pieces." }
  ]
}
{% endschema %}
