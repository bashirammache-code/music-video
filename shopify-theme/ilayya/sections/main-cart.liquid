<div class="cart-page section-padding">
  <div class="container">
    <div class="cart-page__header">
      <h1 class="cart-page__title">{{ 'cart.general.title' | t }}</h1>
      <a href="{{ routes.root_url }}#shop" class="cart-page__return">&larr; Return to shop</a>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.root_url }}#shop" class="btn btn--primary">Shop Here</a>
      </div>
    {%- else -%}
      {%- form 'cart', cart -%}
        <table class="cart-table">
          <thead>
            <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th></th></tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td class="cart-table__product">
                  <a href="{{ item.url }}">
                    {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" width="80">{%- endif -%}
                  </a>
                  <div>
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                    {%- if item.variant.title != 'Default Title' -%}<p class="cart-table__variant">{{ item.variant.title }}</p>{%- endif -%}
                  </div>
                </td>
                <td>{{ item.original_price | money }}</td>
                <td>
                  <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" class="cart-table__qty">
                </td>
                <td>{{ item.final_line_price | money }}</td>
                <td><a href="{{ item.url_to_remove }}" aria-label="Remove">{%- render 'icon' with 'close' -%}</a></td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-page__extra">
          <div class="cart-page__field">
            <label for="CartPageNote">Add a note to your order</label>
            <textarea name="note" id="CartPageNote" rows="3">{{ cart.note }}</textarea>
          </div>
        </div>

        <div class="cart-page__summary">
          {%- comment -%}
            Discount code: not a cart-form field (Shopify has no cart-level
            discount input) — it's a separate form that redirects to the
            native /discount/<code> activation route, same as the drawer.
          {%- endcomment -%}
          <div class="cart-page__discount">
            <input type="text" id="CartPageDiscountInput" placeholder="Discount code" autocomplete="off">
            <button type="button" class="btn btn--outline" id="CartPageDiscountApply">Apply</button>
          </div>
          <p class="cart-page__subtotal">Subtotal <span>{{ cart.total_price | money }}</span></p>
          <p class="cart-page__note">Shipping and taxes calculated at checkout.</p>
          <button type="submit" name="update" class="btn btn--outline">Update Cart</button>
          <button type="submit" name="checkout" class="btn btn--primary">Checkout</button>
        </div>
      {%- endform -%}

      <div class="cross-sell container" id="ProductRecommendations" data-url="{{ routes.product_recommendations_url }}?section_id=product-recommendations&amp;product_id={{ cart.items.first.product_id }}&amp;limit=4" hidden>
        <div class="cross-sell__head"><h3>You may also like</h3>
          <div class="cross-sell__nav">
            <button type="button" class="cross-sell__arrow" data-cross-sell-prev aria-label="Scroll left">&#8249;</button>
            <button type="button" class="cross-sell__arrow" data-cross-sell-next aria-label="Scroll right">&#8250;</button>
          </div>
        </div>
        <div class="cross-sell__row" id="CrossSellRow"></div>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', function () {
          if (window.Ilayya && window.Ilayya.initCrossSell) {
            window.Ilayya.initCrossSell();
          }
        });
      </script>
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "Cart page", "settings": [] }
{% endschema %}
