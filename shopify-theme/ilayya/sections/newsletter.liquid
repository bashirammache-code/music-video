<div class="newsletter">
  <div class="container newsletter__inner">
    <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="newsletter__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__field">
        <input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email address" value="{% if customer %}{{ customer.email }}{% endif %}">
        <button type="submit">{%- render 'icon' with 'arrow' -%}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">Thank you — you're on the list.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the ILAYYA circle" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ]
}
{% endschema %}
