<div class="section-padding testimonials">
  <div class="container">
    <div class="section-heading section-heading--center">
      <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">
            {%- for i in (1..5) -%}{%- render 'icon' with 'star' -%}{%- endfor -%}
          </div>
          <p class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="testimonial-card__author">{{ block.settings.author }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved, daily" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The quality is incredible and it hasn't tarnished once. My new everyday ring." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sofia R." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "author": "Sofia R." } },
      { "type": "testimonial", "settings": { "author": "Maya K." } },
      { "type": "testimonial", "settings": { "author": "Elena T." } }
    ]
  }
}
{% endschema %}
