<div class="brand-story section-padding">
  <div class="container brand-story__grid brand-story__grid--{{ section.settings.image_position }}">
    <div class="brand-story__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="1200" height="{{ 1200 | divided_by: section.settings.image.aspect_ratio }}">
      {%- else -%}
        <div class="brand-story__placeholder"></div>
      {%- endif -%}
    </div>
    <div class="brand-story__content">
      {%- if section.settings.eyebrow != blank -%}<p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="brand-story__text">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url }}" class="btn btn--outline">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
        { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
      ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted for everyday luxury" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>ILAYYA began with a simple idea: jewelry should be worn, not saved for occasions. Every piece is cast in solid gold and finished by hand in small batches.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our Story" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
