<div class="account section-padding">
  <div class="container container--narrow">
    <div class="account-box">
      <h1 class="page__title">Reset Your Password</h1>
      <p class="account-box__note">Enter a new password for {{ email }}.</p>
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label for="ResetPassword">New password</label>
          <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="ResetPasswordConfirm">Confirm password</label>
          <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">Reset Password</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Customer reset password", "settings": [] }
{% endschema %}
