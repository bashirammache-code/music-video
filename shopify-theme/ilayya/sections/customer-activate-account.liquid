<div class="account section-padding">
  <div class="container container--narrow">
    <div class="account-box">
      <h1 class="page__title">Activate Your Account</h1>
      <p class="account-box__note">Create a password to activate your account.</p>
      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label for="ActivatePassword">Password</label>
          <input type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="ActivatePasswordConfirm">Confirm password</label>
          <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">Activate Account</button>
        <button type="submit" name="decline" class="btn btn--outline btn--full">Decline Invitation</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Customer activate account", "settings": [] }
{% endschema %}
