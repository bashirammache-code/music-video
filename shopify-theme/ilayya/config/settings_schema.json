    "settings": [
      { "type": "color", "id": "color_background", "label": "Background (cream)", "default": "#F6F4F1" },
      { "type": "color", "id": "color_text", "label": "Body text (charcoal)", "default": "#241F1D" },
      { "type": "color", "id": "color_accent", "label": "Accent (red) — headings, buttons, links, hover", "default": "#8D0B0B" },
      { "type": "color", "id": "color_accent_deep", "label": "Accent hover (deep red)", "default": "#6E0808" },
